# Copy to frontend/.env.local for `npm run dev` on your machine, with the dev stack from
# ../docker-compose.yml running (docker compose up postgres redis auth templates mailpit api worker).
# Production values are build args instead; see deploy/docker-compose.yml.

# Same origin as the app: next.config.ts rewrites /auth/v1/* to GoTrue in development.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
AUTH_DEV_UPSTREAM=http://localhost:9999
# Dev-only anon key, signed with the dev JWT secret in ../docker-compose.yml. Not a secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
