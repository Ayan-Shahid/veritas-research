# Backend settings for local development (copy to .env.local). The dev compose file overrides
# DATABASE_URL / REDIS_URL / SUPABASE_* for the containers; these values are for running the
# API directly on your machine against the dev stack.
DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-prod
EDGAR_USER_AGENT="Veritas Research contact@example.com"
ANTHROPIC_API_KEY=

# Self-hosted Supabase Auth (GoTrue): access tokens are HS256 JWTs signed with this secret.
# Must equal GOTRUE_JWT_SECRET (the dev value is in docker-compose.yml).
SUPABASE_JWT_SECRET=veritas-dev-only-jwt-secret-not-for-production-0123456789
SUPABASE_URL=
